# Copy to .env, fill every value, NEVER commit .env.
POSTGRES_PASSWORD=
ORYNT_SECRET_KEY=            # openssl rand -hex 32   (encrypts stored wallet credentials; losing it makes them unreadable)
ORYNT_ISSUER_KEY=            # openssl rand -hex 32   (signs receipts; publish its PUBLIC key as your trust root)
ORYNT_DOMAIN=                # a domain YOU own
ORYNT_APP_URL=               # https://<that domain>
ORYNT_METRICS_TOKEN=         # openssl rand -hex 24
ORYNT_IMAGE_TAG=local
# --- commissioning (leave empty until real accounts exist; the API refuses to boot with placeholders unless ORYNT_ALLOW_UNCOMMISSIONED=1) ---
ORYNT_MAIL_PROVIDER=         # resend | brevo
ORYNT_MAIL_FROM=             # "Orynt <no-reply@your-verified-domain>"
RESEND_API_KEY=
BREVO_API_KEY=
ORYNT_MAIL_WEBHOOK_SECRET=
ORYNT_BILLING_PROVIDER=      # stripe | paystack
ORYNT_BILLING_WEBHOOK_SECRET=
ORYNT_BILLING_API_KEY=
ORYNT_ALLOW_UNCOMMISSIONED=  # "1" only for a staging environment that knowingly runs without the above
