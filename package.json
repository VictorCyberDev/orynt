{
  "name": "orynt",
  "private": true,
  "version": "0.1.0",
  "description": "Orynt — Bitcoin-native payment authorization and operations. Every payment. Under control.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @orynt/api test:integration",
    "test:e2e": "pnpm --filter @orynt/web test:e2e",
    "db:start": "bash infra/postgres/start-local.sh",
    "db:migrate": "pnpm --filter @orynt/api db:migrate",
    "db:seed": "pnpm --filter @orynt/api db:seed",
    "dev:api": "pnpm --filter @orynt/api dev",
    "dev:web": "pnpm --filter @orynt/web dev",
    "regtest:up": "bash infra/regtest/up.sh",
    "regtest:down": "bash infra/regtest/down.sh",
    "demo:full": "bash scripts/demo-full.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
