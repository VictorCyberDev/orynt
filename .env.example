# Copy to .env (never commit .env). All values below are development defaults; nothing here is a production secret.
ORYNT_ENV=development                 # development | test | production
DATABASE_URL=postgres://orynt:orynt@127.0.0.1:5432/orynt_dev
PORT=8787
HOST=127.0.0.1
# REQUIRED in production (64 hex chars each). Generate: openssl rand -hex 32
# ORYNT_SECRET_KEY=   # encrypts wallet credentials + webhook secrets at rest. Losing it = losing stored credentials.
# ORYNT_ISSUER_KEY=   # ed25519 private key that signs receipts and audit checkpoints. Publish its PUBLIC key out-of-band.
ORYNT_ALLOW_MAINNET=0                 # leave 0. Mainnet execution is unsupported and unaudited.
ORYNT_FAILPOINTS=0                    # 1 only for tests/demo; the server REFUSES to start with 1 in production
ORYNT_SEED_DEMO=0                     # 1 seeds a labelled demo workspace on the simulator (refused in production)
ORYNT_WORKER=1
ORYNT_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://127.0.0.1:5173
ORYNT_RATE_LIMIT_PER_MIN=600
ORYNT_SEND_TIMEOUT_SECONDS=30
ORYNT_RECONCILE_INITIAL_DELAY_SECONDS=10
# ORYNT_METRICS_TOKEN=                # bearer token for /metrics when not scraped from loopback
LOG_LEVEL=info
